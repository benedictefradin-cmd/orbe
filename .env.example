# Copiez ce fichier en .env et renseignez les valeurs. Ne commitez jamais .env.

# Supabase (Project Settings, API). La clé service_role reste côté serveur.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Accès au tableau de bord /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Clé de signature des sessions et des jetons de formulaire, 32 caractères minimum
# (par exemple : openssl rand -base64 48)
ADMIN_SESSION_SECRET=
# Sel de l'empreinte des adresses IP, 16 caractères minimum (openssl rand -base64 24)
IP_HASH_SALT=

# Développement local uniquement
# DATABASE_DRIVER=pglite       # Postgres embarqué au lieu de Supabase (npm run dev:local)
# PGLITE_DIR=.data/pglite
# DATE_SIMULEE=2026-12-12T00:00:00+01:00   # simule une date, ignorée en production
